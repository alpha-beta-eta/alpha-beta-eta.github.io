#lang racket
(provide ptlp.html)
(require SMathML)
(define $nat (Mi "nat"))
(define App (&split 1))
(define $even (Mi "even"))
(define (&even x)
  (App $even x))
(define $odd (Mi "odd"))
(define (&odd x)
  (App $odd x))
(define (&succ x)
  (App $s x))
(define $times (Mi "times"))
(define (&times n m p)
  (App $times n m p))
(define (Lam x M)
  (: $lambda x $. M))
(define $impl $sup)
(define $:: (Mo "::"))
(define $\|- (Mo "&vdash;"))
(define (!- . x*)
  (let-values (((x* y*) (split-at-right x* 1)))
    (: (apply &cm x*) $\|- (car y*))))
(define-infix*
  (&\|- $\|-)
  (&:: $::)
  (&impl $impl))
(define-@lized-op*
  (@even &even)
  (@odd &odd)
  (@succ &succ)
  (@times &times)
  (@Lam Lam)
  (@App App)
  (@impl &impl))
(define (∃ x p)
  (: $exists x $. p))
(define (∀ x p)
  (: $forall x $. p))
(define (subst B t x)
  (: B (bra0 (&/ t x))))
(define ptlp.html
  (TnTmPrelude
   #:title "证明论和逻辑编程"
   #:css "styles.css"
   (H1. "证明论和逻辑编程")
   (H2 "前言")
   (P "本书发展了经典逻辑, 直觉主义逻辑与线性逻辑的证明论, "
      "并展示了其在逻辑编程语言的设计与使用中的应用. "
      "我们利用Gentzen的相继式演算 (sequent calculus), "
      "为基于一阶和高阶的经典逻辑, "
      "直觉主义逻辑与线性逻辑的逻辑编程语言建立了一个证明论基础. "
      "这一进路为若干著名语言提供了根基, "
      "包括Prolog (在经典逻辑中采用一阶Horn子句) "
      "和λProlog (在直觉主义逻辑中使用高阶遗传Harrop公式), "
      "以及线性逻辑编程语言Lolli和Forum. "
      "正如我们将要说明的, 这些表达能力不断增强的逻辑编程语言, "
      "使逻辑编程范式能够刻画模块化编程, "
      "高阶编程, 抽象数据类型, 状态封装以及并发等诸多核心方面.")
