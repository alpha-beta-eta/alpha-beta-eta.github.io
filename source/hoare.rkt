          (Li "符号" (&cm $S $S_1 $..h $S_n)
              "代表任意的陈述. 这些是像"
              (&cm (&< :X :Y) (&= (^ :X $2) $1))
              "之类的条件, 其要么为真要么为假.")
          (Li "符号" (&cm $C $C_1 $..h $C_n)
              "代表我们编程语言里的任意命令; "
              "这些会在本节的剩余部分进行描述."))
      "项和陈述在第1.5节进行了更为细致的描述.")
   (H4. "赋值")
   (P (B "句法: ") (&:= $V $E))
   (P (B "语义: ")
      "状态的改变由将项" $E "之值赋给变量" $V
      "完成. 所有的变量都假定具有全局作用域.")
   (P (B "例子: ") (Code "X:=X+1"))
   (P "这给变量" :X "之值加上一.")
   (H4. "序列")
   (P (B "句法: ") (&\; $C_1 $..c $C_n))
   (P (B "语义: ")
      "命令" (&cm $C_1 $..h $C_n)
