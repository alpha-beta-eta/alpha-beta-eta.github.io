   (P (B "例子: ") (Code "R:=X; X:=Y; Y:=R"))
   (P "变量" :X "和" :Y "之值经由临时变量" :R
      "进行了互换. 这个命令具有将变量" :R
      "之值变为变量" :X "之旧值的"
      (Em "副作用") ". {译注: 这个还是这些?}")
   (H4. "条件式")
   (P (B "句法: ") (IF $S $C_1 $C_2))
   (P (B "语义: ")
      "如果陈述" $S "在当前状态下为真, 那么"
