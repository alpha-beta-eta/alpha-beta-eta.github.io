#lang racket
(provide hoare.html)
(require SMathML)
(define (Func . x*)
  (apply : (map-toggle
            #f (λ (f) (^^ $-> f)) x*)))
(define (Box #:attr* [attr* '()] . xml*)
  `(menclose ,(attr*-set attr* 'notation "box")
             . ,xml*))
(define (AssignmentAxiom P V E)
  (!- (Hoare (P E) (&:= V E) (P V))))
(define (subst P E V)
  (: P (bra0 (&/ E V))))
(define (!- . x*)
  (let-values (((a* b*) (split-at-right x* 1)))
    (let ((b (car b*)))
      (: (apply &cm a*) $vdash b))))
(define $impl $=>)
(define split2 (&split 2))
(define (Hoare P C Q)
  (split2 (cur0 P) C (cur0 Q)))
(define (THoare P C Q)
  (split2 (bra0 P) C (bra0 Q)))
(define (Pid str)
  (Mi str #:attr* '((mathvariant "monospace"))))
(define :WHILE (Pid "WHILE"))
(define :DO (Pid "DO"))
(define (WHILE S C)
  (split2 :WHILE S :DO C))
(define (AWHILE S R C)
  (split2 :WHILE S :DO (cur0 R) C))
(define :FOR (Pid "FOR"))
(define :IF (Pid "IF"))
(define :THEN (Pid "THEN"))
(define :ELSE (Pid "ELSE"))
(define (IF S C1 C2)
  (split2 :IF S :THEN C1 :ELSE C2))
(define :x (Pid "x"))
(define :y (Pid "y"))
(define :n (Pid "n"))
(define :Q (Pid "Q"))
(define :R (Pid "R"))
(define :X (Pid "X"))
(define :Y (Pid "Y"))
(define :Z (Pid "Z"))
(define :T (Pid "T"))
(define :F (Pid "F"))
(define (pointsTo a b)
  (&\|-> a b))
(define-infix*
  (&impl $impl))
(define-@lized-op*
  (@/ &/)
  (@> &>))
(define ((law #:id [id #f]) . html*)
  (keyword-apply
   Div '(#:attr*) '(((class "frame"))) html*))
(define (Center . html*)
  `(div ((style "text-align: center;")) . ,html*))
(define hoare.html
  (TnTmPrelude
