#lang racket
(provide hoare.html)
(require SMathML)
(define $curried (Mi "curried"))
(define $Com (Mi "Com"))
(define $State (Mi "State"))
(define $Var (Mi "Var"))
(define $Val (Mi "Val"))
(define $Exp (Mi "Exp"))
(define $Sta (Mi "Sta"))
(define $Num (Mi "Num"))
(define $f_R^curried
  (_^ $f $R $curried))
(define (Anno R C)
  (: (cur0 R) C))
(define (∀ x P)
  (: $forall x $. P))
(define (∃ x P)
  (: $exists x $. P))
(define (Func . x*)
  (apply : (map-toggle
            #f (λ (f) (^^ $-> f)) x*)))
(define (Box #:attr* [attr* '()] . xml*)
  `(menclose ,(attr*-set attr* 'notation "box")
             . ,xml*))
(define (AssignmentAxiom P V E)
  (!- (Hoare (P E) (&:= V E) (P V))))
(define (subst P E V)
  (: P (bra0 (&/ E V))))
(define (!- . x*)
  (let-values (((a* b*) (split-at-right x* 1)))
    (let ((b (car b*)))
      (: (apply &cm a*) $vdash b))))
(define $impl $=>)
(define split2 (&split 2))
(define App split2)
(define (If q a e)
  (split2 $if q $then a $else e))
(define (Lam x e)
  (: $lambda x $. e))
(define (Hoare P C Q)
  (split2 (cur0 P) C (cur0 Q)))
(define (THoare P C Q)
  (split2 (bra0 P) C (bra0 Q)))
(define $Bool (Mi "Bool"))
(define (Pid str)
  (Mi str #:attr* '((mathvariant "monospace"))))
(define :WHILE (Pid "WHILE"))
(define :DO (Pid "DO"))
(define (WHILE S C)
  (split2 :WHILE S :DO C))
(define (AWHILE S R C)
  (split2 :WHILE S :DO (cur0 R) C))
(define :FOR (Pid "FOR"))
(define :IF (Pid "IF"))
(define :THEN (Pid "THEN"))
(define :ELSE (Pid "ELSE"))
(define (IF S C1 C2)
  (split2 :IF S :THEN C1 :ELSE C2))
(define :BEGIN (Pid "BEGIN"))
(define :END (Pid "END"))
(define (BEGIN . C*)
  (split2 :BEGIN (apply &\; C*) :END))
(define :x (Pid "x"))
(define :y (Pid "y"))
(define :n (Pid "n"))
(define :Q (Pid "Q"))
(define :R (Pid "R"))
(define :X (Pid "X"))
(define :Y (Pid "Y"))
(define :Z (Pid "Z"))
(define :T (Pid "T"))
(define :F (Pid "F"))
(define :sin (Pid "sin"))
(define (&sin X)
  (app :sin X))
(define :rem (Pid "rem"))
(define (&rem X Y)
  (appl :rem X Y))
(define :max (Pid "max"))
(define (&max X Y)
  (appl :max X Y))
(define :fact (Pid "fact"))
(define (fact n)
  (app :fact n))
(define :ODD (Pid "ODD"))
(define (&ODD X)
  (app :ODD X))
(define :EVEN (Pid "EVEN"))
(define (&EVEN X)
  (app :EVEN X))
(define :PRIME (Pid "PRIME"))
(define (&PRIME X)
  (app :PRIME X))
(define :MAX (Pid "MAX"))
(define (Pred str)
  (Mi str #:attr* '((mathvariant "sans-serif"))))
(define :Iter (Pred "Iter"))
(define (Iter n p c s1 s2)
  (App :Iter n p c s1 s2))
(define :Esem (Pred "Esem"))
(define (Esem E s)
  (split2 :Esem E s))
(define :Ssem (Pred "Ssem"))
(define Ssem
  (case-lambda
    ((S s) (App :Ssem S s))
    ((S) (App :Ssem S))))
(define :Csem (Pred "Csem"))
(define Csem
  (case-lambda
    ((C s1 s2) (App :Csem C s1 s2))
    ((C) (App :Csem C))))
(define :Hsem (Pred "Hsem"))
(define (Hsem P C Q)
  (split2 :Hsem P C Q))
(define (HSEM P C Q)
  (∀ (&cm $s_1 $s_2)
     (&impl (&conj (Ssem P $s_1)
                   (Csem C $s_1 $s_2))
            (Ssem Q $s_2))))
(define (pointsTo a b)
  (&\|-> a b))
(define-infix*
  (&impl $impl))
(define-@lized-op*
  (@App App)
  (@∀ ∀)
  (@∃ ∃)
  (@Lam Lam)
  (@If If)
  (@<= &<=)
  (@impl &impl)
  (@:= &:=)
  (@IF IF)
  (@WHILE WHILE)
  (@\; &\;)
  (@Iter Iter)
  (@Esem Esem)
  (@Ssem Ssem)
  (@Csem Csem)
  (@subst subst)
  (@/ &/)
  (@< &<)
  (@> &>))
(define ((law #:id [id #f]) . html*)
  (keyword-apply
   Div '(#:attr*) '(((class "frame"))) html*))
(define (Center . html*)
  `(div ((style "text-align: center;")) . ,html*))
(define X=R+Y*Q
  (&= :X (&+ :R (@c* :Y :Q))))
(define hoare.html
  (TnTmPrelude
