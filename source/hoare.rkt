   (P (B "语义: ")
      "命令" (&cm $C_1 $..h $C_n)
      "按照顺序进行执行.")
   (P (B "例子: ") (Code "R:=X; X:=Y; Y:=R"))
   (P "变量" :X "和" :Y "之值经由临时变量" :R
      "进行了互换. 这个命令具有将变量" :R
      "之值变为变量" :X "之旧值的"
      (Em "副作用") ". {译注: 这个还是这些?}")
   (H4. "条件式")
   (P (B "句法: ") (IF $S $C_1 $C_2))
   (P (B "语义: ")
      "如果陈述" $S "在当前状态下为真, 那么"
      $C_1 "被执行. 如果" $S "为假, 那么"
      $C_2 "被执行.")
   (P (B "例子: ") (Code "IF X&lt;Y THEN MAX:=Y ELSE MAX:=X"))
   (P "变量" :MAX "之值被设为" :X "和" :Y
      "之值的最大值.")
   (H4. :WHILE "命令")
   (P (B "句法: ") (WHILE $S $C))
   (P (B "语义: ")
      "如果陈述" $S "在当前状态下为真, 那么"
      $C "被执行, 然后" :WHILE "命令重复. 如果"
      $S "为假, 那么什么也不做. 因此, " $C
      "反复执行, 直至" $S "的值变为假. 如果"
      $S "永远不变为假, 那么该命令的执行永远不终止.")
   (P (B "例子: ") (Code "WHILE ¬(X=0) DO X:=X-2"))
   (P "如果" :X "之值非零, 那么其值会减去" $2
      ", 然后进程重复. 这个" :WHILE
      "命令将会终止 (此时" :X "有着值" $0
      "), 如果" :X "的值是一个非负的偶数. "
      "其他状态下都不会终止.")
   (H4. "句法总结")
   (P "我们的小语言的句法可以用BNF记号总结如下:"
      (CodeB "&lt;command> ::= &lt;variable> := &lt;term>
           |  &lt;command>; ...; &lt;command>
           |  IF &lt;statement> THEN &lt;command> ELSE &lt;command>
           |  WHILE &lt;statement> DO &lt;command>"))
   (P "请注意:"
      (Ul (Li "变量, 项, 陈述描述于第1.5节.")
