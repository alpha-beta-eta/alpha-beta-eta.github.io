          (Li "符号" (&cm $E $E_1 $..h $E_n)
              "代表任意的表达式 (或者说项). "
              "这些是像" (&cm (&+ :X $1) (Msqrt $2))
              "之类的东西, 其指称着值 (通常是数字).")
          (Li "符号" (&cm $S $S_1 $..h $S_n)
