#lang racket
(provide hot_glossary.html)
(require SMathML "hot_utils.rkt")
(define-syntax GlossaryTable
  (syntax-rules ()
    ((_ (x ...) ...)
     (set-attr*
      (Table
       (Tr (Th "英文") (Th "中文") (Th "首次出现"))
       (Tr (Td x) ...)
       ...)
      'align "center"))))
(define (L n)
  (LINK (format "第~a讲" n)
        (format "hot_~a.html"
                (case n
                  ((1) "01_sax")
                  ((2) "02_typechecking")))))
(define hot_glossary.html
