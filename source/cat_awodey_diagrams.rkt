(define (make-triangle.svg A B C #:labels [labels '()]
                           #:dotted? [dotted? #f] #:reversed? [reversed? #f]
                           #:diagonal-offset [diagonal-offset (vec -45 20)])
  (define pA (pt 40 40))
  (define pB (pt 240 40))
  (define pC (pt 240 200))
  (define (arrow from to #:gap [gap 16])
    (if reversed?
        (:edge to from #:gap gap)
        (:edge from to #:gap gap)))
  (define AC (arrow pA pC #:gap 20))
  (apply
   diagram
   300 230
   (:node pA A)
   (:node pB B)
   (:node pC C)
   (arrow pA pB)
   (arrow pB pC)
   (if dotted? (set-dotted AC) AC)
   (if (null? labels)
       '()
       (map (lambda (from to offset label)
              (:edge-label from to #:offset offset label))
            (list pA pB pA)
            (list pB pC pC)
            (list (vec 0 -18) (vec 16 0) diagonal-offset)
            labels))))
