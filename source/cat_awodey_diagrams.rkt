(define zero-vec (vec 0 0))
(define (:FO position #:offset [offset zero-vec]
             #:width [width 100] #:height [height 30] . x*)
  (define pos
    (pt+ position offset))
  (keyword-apply
   ForeignObject
   '(#:attr*)
   `(((x ,(n2s (pt-x pos)))
      (y ,(n2s (pt-y pos)))
      (width ,(n2s width))
      (height ,(n2s height))))
   x*))
(define (:arrow-prop start end #:prop [prop 0.7])
  (define t (/ (- 1 prop) 2))
  (define start^ (pt-lerp start end t))
  (define end^ (pt-lerp start end (- 1 t)))
  (:arrow start^ end^))
(define (set-dotted line)
  (set-attr* line 'stroke-dasharray "2 2"))
(define (diagram width height . svg*)
  (keyword-apply
   Svg
   '(#:attr*)
   `(((width ,(n2s width))
      (height ,(n2s height))
      (stroke "black")
      (style "display: block; margin: auto;")))
   (Defs arrow-head)
   svg*))
(define node-size (vec 120 30))
(define (:node center #:offset [offset zero-vec] x)
  (:FO center
       #:offset (vec+ offset (vec* -1/2 node-size))
       #:width (vec-x node-size)
       #:height (vec-y node-size)
       (Div #:attr* '((style "display: flex; align-items: center; justify-content: center; height: 100%;"))
            x)))
(define (:edge from to #:gap [gap 16] #:shift [shift zero-vec]
               #:start-gap [start-gap gap] #:end-gap [end-gap gap])
  (define u (vec-normalize (pt- to from)))
  (:arrow (pt+ (pt+ from shift) (vec* start-gap u))
          (pt+ (pt+ to shift) (vec* (- end-gap) u))))
(define (:epi-edge from to #:gap [gap 16])
  (define u (vec-normalize (pt- to from)))
  (define end (pt+ to (vec* (- gap) u)))
  (G (:edge from to #:gap gap)
     (:arrow (pt+ end (vec* -7 u))
             (pt+ end (vec* -6 u)))))
(define (:embed-edge from to #:gap [gap 16] #:radius [r 3])
  (define u (vec-normalize (pt- to from)))
  (define n (vec (vec-y u) (- (vec-x u))))
  (define start (pt+ from (vec* gap u)))
  (define end (pt+ start (vec* (* 2 r) n)))
  (G (:edge from to #:gap gap)
     (Path #:attr*
           `((d ,(format "M ~a ~a A ~a ~a 0 0 1 ~a ~a"
                         (n2s (pt-x start)) (n2s (pt-y start))
                         (n2s r) (n2s r)
                         (n2s (pt-x end)) (n2s (pt-y end))))
             (fill "none")))))
(define (:edge-label from to #:offset [offset zero-vec] #:normal [normal 0] x)
  (define d (vec-normalize (pt- to from)))
  (define n (vec (vec-y d) (- (vec-x d))))
  (:node (pt-lerp from to 1/2)
         #:offset (vec+ offset (vec* normal n))
         x))
