#lang racket
(provide (all-defined-out))
(require SMathML)
(define-syntax SimpleTable
  (syntax-rules ()
    ((_ (x ...) ...)
     (Table
      (Tr (Td x) ...)
      ...))))
(define (Href url . html*)
  (keyword-apply A '(#:attr*) `(((href ,url))) html*))
(define (Miv str variant)
  (Mi str #:attr* `((mathvariant ,variant))))
(define (Rn str)
  (Mtext #:attr* '((class "small-caps")) str))
(define $space4 (&space 4))
;session types
(define $.0 (Mo "." #:attr* '((lspace "0") (rspace "0"))))
(define $? (Mi "?"))
(define $int:ty (Miv "int" "sans-serif"))
(define $end (Miv "end" "sans-serif"))
(define $end? (_ $end $?))
(define $end! (_ $end $!))
(define $plus (Miv "plus" "sans-serif"))
(define $neg:lab (Miv "neg" "sans-serif"))
(define $quit (Miv "quit" "sans-serif"))
(define $&:id (Mi "&amp;"))
(define $⊕:id (Mi "&oplus;"))
(define $⊥ (Mo "&perp;"))
(define (In T U) (: $? T $.0 U))
(define (Out T U) (: $! T $.0 U))
(define (Ext . x*)
  (: $&:id (apply setE (map2 &: x*))))
(define (Int . x*)
  (: $⊕:id (apply setE (map2 &: x*))))
(define (Ext* l T)
  (_ (: $&:id (setE (&: l T))) (∈ $i $I)))
(define (Int* l T)
  (_ (: $⊕:id (setE (&: l T))) (∈ $i $I)))
(define (Dual T) (^ T $⊥))
;processes
(define $inact (Mn "0" #:attr* '((mathvariant "bold"))))
(define $▷ (Mo "&#x25B7;"))
(define $◁ (Mo "&#x25C1;"))
(define (Wait x P) (: x $? $.0 P))
(define (Close x P) (: x $! $.0 P))
(define (Recv x y P) (: x $? y $.0 P))
(define (Send x y P) (: x $! y $.0 P))
(define (Par . P*) (apply &\| P*))
(define (ν x y) (tu0 (: $nu x y)))
(define (Res x y P) (: (ν x y) P))
(define (Branch x . x*)
  (: x $▷ (apply setE (map2 &: x*))))
(define (Branch* x l P)
  (: x $▷ (_ (setE (&: l P)) (∈ $i $I))))
(define (Sel x l P) (: x $◁ l $.0 P))
(define (Subst Q v z)
  (: Q (bra0 (: v $/ z))))
