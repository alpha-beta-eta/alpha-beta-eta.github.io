(define $· (Mi "&middot;"))
(define (&cell a v)
  (&split2 $cell a v))
(define (&proc P)
  (&split2 $proc P))
(define (&write c v)
  (&split2 $write c v))
(define (&read c K)
  (&split2 $read c K))
(define (&cut x A P Q)
  (&split2 $cut (@: x A) P Q))
(define (&id a b)
  (&split2 $id a b))
(define (&call p . a*)
  (apply &split2 $call p a*))
(define (&fresh a)
  (@ (: a (% " 新鲜"))))
(define (&subst b y)
  (tu0 (: b $/ y)))
(define $:: (Mo "::"))
(define $▷ (Mo "&triangleright;"))
(define-infix*
  (&≜ $≜)
