#lang racket
(provide (all-defined-out))
(require SMathML)
(define $space2 (&space 2))
(define &split2 (&split 2))
(define &split16 (&split 16))
(define (&rull label . j*)
  (define r
    (if (null? (cdr j*))
        (~ #:attr* '((displaystyle "true")) (Mrow) (car j*))
        (apply &rule j*)))
  (if label (: r label) r))
(define (Href url . html*)
  (keyword-apply A '(#:attr*) `(((href ,url))) html*))
(define $UnderBrace (Mo "&UnderBrace;"))
(define (UnderBrace x label)
  (__ (__ x $UnderBrace) label))
(define (Miv str variant)
  (Mi str #:attr* `((mathvariant ,variant))))
(define (Lab str)
  (UnderBar (Miv str "sans-serif")))
(define-syntax-rule (define-label* (id str) ...)
  (begin
    (define id (Lab str))
    ...))
(define-label*
  ($inl "inl")
  ($inr "inr")
  ($zero "zero")
  ($succ "succ")
  ($false:lab "false")
  ($true:lab "true")
  ($nil "nil")
  ($cons "cons"))
(define &zero
  (case-lambda
    (() (ap $zero (tu0)))
    ((x) (app $zero x))))
(define (&succ x) (app $succ x))
;types
(define $⊗ (Mo "&otimes;" #:attr* '((form "infix") (largeop "false"))))
(define $⊗:id (Mi "&otimes;"))
(define $⊗I (: $⊗:id $I))
(define $⊗X (: $⊗:id $X))
(define $⊗L (: $⊗:id $L))
(define $unit (Miv "1" "bold"))
(define $unit0 (Miv "unit" "bold"))
(define $unitI (: $unit $I))
(define $unitX (: $unit $X))
(define $unitL (: $unit $L))
(define $⊕ (Mo "&oplus;" #:attr* '((form "infix") (largeop "false"))))
(define $⊕:id (Mi "&oplus;"))
(define $⊕I (: $⊕:id $I))
(define $⊕I_1 (: $⊕:id $I_1))
(define $⊕I_2 (: $⊕:id $I_2))
(define $⊕X (: $⊕:id $X))
(define $⊕X_1 (: $⊕:id $X_1))
(define $⊕X_2 (: $⊕:id $X_2))
(define $⊕L (: $⊕:id $L))
(define (⊕ . x*)
  (: $⊕:id (apply setE (map2 &: x*))))
(define (⊕* l A L)
  (_ (: $⊕:id (setE (&: l A))) (∈ l L)))
(define (Σ* l A L)
  (sum (∈ l L) (@: l A)))
(define $≜ (^^ $= $Delta:normal))
(define $type (Miv "type" "bold"))
(define $nat (Miv "nat" "sans-serif"))
(define $list (Miv "list" "sans-serif"))
