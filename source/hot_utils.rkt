;semantic objects and commands
(define $cell (Miv "cell" "sans-serif"))
(define $proc (Miv "proc" "sans-serif"))
(define $write (Miv "write" "bold"))
(define $read (Miv "read" "bold"))
(define $cut (Miv "cut" "bold"))
