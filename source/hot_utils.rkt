(define (&seq ctx P dest)
  (&vdash ctx (&:: P dest)))
(define Γ_1 (_ Γ $1))
(define Γ_2 (_ Γ $2))
(define Δ_1 (_ Δ $1))
(define Δ_2 (_ Δ $2))
