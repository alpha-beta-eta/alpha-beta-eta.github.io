;algorithmic typing
(define $out (Mo "/"))
(define $∖ (Mo "&setminus;"))
(define-infix*
  (&out $out)
  (&∖ $∖))
(define (&aseq ctx P dest out)
  (&vdash ctx (&out (&:: P dest) out)))
;dynamics of sax (lectures 1, 2)
(define sax-dynamics
  (set-attr*
   (&Table
    ((&proc (@ (&write $c $v)))
     $--> (&cell $c $v) $)
    ((&cm (&cell $c $v) (&proc (@ (&read $c $K))))
     $--> (&proc (@ (&▷ $v $K))) $)
    ((&proc (@ (&cut $x $A (app $P $x) (app $Q $x))))
     $--> (&cm (&proc (app $P $a)) (&proc (app $Q $a)))
     (&fresh $a))
    ((&cm (&cell $b $v) (&proc (@ (&id $a $b))))
     $--> (&cell $a $v) $)
    ((&proc (@ (&call $p $a $b:bold)))
     $--> (&proc (appl $Q $a $b:bold)) $)
    ($ $ (@ (&in (&= (&split2 $proc:kw $p $x $y:bold)
                     (appl $Q $x $y:bold))
                 Σ))
       $))
   'columnalign "right center left left"))
(define sax-▷
  (set-attr*
   (&Table
    ((&▷ (tu0) (&=> (tu0) $Q)) $= $Q)
    ((&▷ (tu0 $a $b) (&=> (tu0 $x $y) (appl $Q $x $y)))
     $= (appl $Q $a $b))
    ((&▷ (app $k $a)
         (_ (setE (&=> (app $ell $y_ell) (app $Q_ell $y_ell)))
            (∈ $ell $L)))
     $= (app $Q_k $a)))
   'columnalign "right center left"))
